{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graphunslopify:runtime-identity:1",
  "title": "Actual scientific runtime source identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi",
    "source_sha256",
    "functions",
    "components"
  ],
  "properties": {
    "abi": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "figure_runtime.py"
      ],
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
