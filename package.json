{
  "name": "graph-unslopify",
  "version": "0.8.0",
  "description": "MCP server that turns a semantic figure spec into runnable matplotlib code.",
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "vercel dev",
    "deploy": "vercel deploy --prod",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "render-check": "node --experimental-strip-types scripts/render-check.ts",
    "baseline": "node --experimental-strip-types scripts/baseline.ts",
    "example-data": "node --experimental-strip-types scripts/make-example-data.ts",
    "test:python": "node --experimental-strip-types scripts/pytest.ts",
    "recipe-check": "node --experimental-strip-types scripts/recipe-check.ts",
    "compose-check": "node --experimental-strip-types scripts/compose-check.ts",
    "queue": "node --experimental-strip-types scripts/queue.ts",
    "gallery-check": "node --experimental-strip-types scripts/gallery-check.ts",
    "build:translator": "node --experimental-strip-types scripts/build-translator.ts",
    "preview-check": "node --experimental-strip-types scripts/preview-check.ts",
    "cell-contrast-check": "node --experimental-strip-types scripts/cell-contrast-check.ts"
  },
  "type": "module",
  "dependencies": {
    "mcp-handler": "^2.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "license": "MIT"
}
