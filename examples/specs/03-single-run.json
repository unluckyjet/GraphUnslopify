{
  "kind": "line",
  "x": {
    "field": "epoch",
    "label": "Training epoch"
  },
  "y": {
    "field": "accuracy",
    "label": "Test accuracy",
    "unit": "%"
  },
  "aggregation": "none",
  "marker": true,
  "legend": {
    "show": false
  },
  "data": {
    "path": "data/training.csv",
    "columns": [
      "model",
      "seed",
      "epoch",
      "accuracy",
      "loss"
    ]
  },
  "output": {
    "stem": "03-single-run"
  },
  "filter": [
    {
      "field": "model",
      "op": "eq",
      "value": "ours"
    },
    {
      "field": "seed",
      "op": "eq",
      "value": 0
    }
  ]
}
